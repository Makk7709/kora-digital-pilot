# ============================================================================
# KORA DIGITAL — Environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env` (and optionally `.env.local`) and fill in your
# real credentials. NEVER commit a populated `.env` file.
#
# Variables prefixed with VITE_ are exposed to the browser bundle.
# Do NOT put long-lived production secrets behind VITE_ — proxy via server.cjs.
# ============================================================================

# --- Application ------------------------------------------------------------
VITE_APP_NAME=Kora Digital
VITE_APP_VERSION=1.0.0
VITE_APP_URL=http://localhost:8088
NODE_ENV=development

# --- Proxy server (server.cjs) ---------------------------------------------
PROXY_PORT=3001

# --- Perplexity API ---------------------------------------------------------
# https://www.perplexity.ai/settings/api
VITE_PERPLEXITY_API_KEY=your_perplexity_api_key_here
VITE_PERPLEXITY_MODEL=sonar-pro
VITE_PERPLEXITY_MAX_TOKENS=4000
VITE_PERPLEXITY_TEMPERATURE=0.7

# --- OpenAI / ChatGPT -------------------------------------------------------
# https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_CHATGPT_API_KEY=your_openai_api_key_here
VITE_CHATGPT_MODEL=gpt-4-turbo

# --- Anthropic / Claude -----------------------------------------------------
# https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- LinkedIn OAuth ---------------------------------------------------------
# https://www.linkedin.com/developers/apps
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id
VITE_LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
VITE_LINKEDIN_REDIRECT_URI=http://localhost:8088/auth/linkedin/callback

# --- Supabase (optional in dev, REQUIRED in staging/production) ------------
# Create a free project at https://supabase.com, then copy:
#   - Project URL                  -> VITE_SUPABASE_URL + SUPABASE_URL
#   - anon public key              -> VITE_SUPABASE_ANON_KEY
#   - service_role secret          -> SUPABASE_SERVICE_ROLE_KEY (server only)
# When these are missing, the app falls back to an in-memory demo session
# (see src/contexts/AuthContext.tsx). Never expose SERVICE_ROLE in the bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- App identity -----------------------------------------------------------
APP_NAME=Kora Digital Pilot
APP_ENV=development
