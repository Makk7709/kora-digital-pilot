# 🤖 Configuration IA locale - Kora Digital
# Copy this file to `.env.local` and fill with your real keys.
# `.env.local` is gitignored.

# OpenAI / ChatGPT — https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_CHATGPT_API_KEY=your_openai_api_key_here

# Anthropic / Claude — https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Perplexity — https://www.perplexity.ai/settings/api
VITE_PERPLEXITY_API_KEY=your_perplexity_api_key_here

# LinkedIn OAuth — https://www.linkedin.com/developers/apps
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id
VITE_LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
VITE_LINKEDIN_REDIRECT_URI=http://localhost:8088/auth/linkedin/callback
