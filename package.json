{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "proxy": "node server.cjs",
    "proxy:staging": "NODE_ENV=staging node server.cjs",
    "proxy:production": "NODE_ENV=production node server.cjs",
    "wait-for-proxy": "node -e \"const http = require('http'); const checkProxy = () => { http.get('http://localhost:3001/api/health', (res) => { if (res.statusCode === 200) { console.log('✅ Proxy ready'); process.exit(0); } else { setTimeout(checkProxy, 500); } }).on('error', () => { setTimeout(checkProxy, 500); }); }; checkProxy();\"",
    "wait-for-proxy:staging": "node -e \"const http = require('http'); const checkProxy = () => { http.get('http://localhost:4001/api/health', (res) => { if (res.statusCode === 200) { console.log('✅ Staging Proxy ready'); process.exit(0); } else { setTimeout(checkProxy, 500); } }).on('error', () => { setTimeout(checkProxy, 500); }); }; checkProxy();\"",
    "wait-for-proxy:production": "node -e \"const http = require('http'); const checkProxy = () => { http.get('http://localhost:5001/api/health', (res) => { if (res.statusCode === 200) { console.log('✅ Production Proxy ready'); process.exit(0); } else { setTimeout(checkProxy, 500); } }).on('error', () => { setTimeout(checkProxy, 500); }); }; checkProxy();\"",
    "dev:full": "concurrently \"npm run proxy\" \"npm run wait-for-proxy && npm run dev\"",
    "dev:staging": "concurrently \"npm run proxy:staging\" \"npm run wait-for-proxy:staging && VITE_ENV=staging npm run dev\"",
    "dev:production": "concurrently \"npm run proxy:production\" \"npm run wait-for-proxy:production && NODE_ENV=production npm run dev\"",
    "start": "npm run dev:full",
    "start:staging": "npm run dev:staging",
    "start:production": "npm run dev:production",
    "health-check": "curl -s http://localhost:3001/api/health | jq '.' || echo 'Health check failed'",
    "health-check:staging": "curl -s http://localhost:4001/api/health | jq '.' || echo 'Staging health check failed'",
    "health-check:production": "curl -s http://localhost:5001/api/health | jq '.' || echo 'Production health check failed'",
    "ports:check": "lsof -i :8088 -i :8089 -i :8090 -i :8091 -i :3001 -i :3002 -i :3003 -i :4001 -i :5001 || echo 'No ports in use'",
    "ports:kill": "pkill -f 'node.*server.cjs' && pkill -f 'vite' || echo 'No processes to kill'",
    "ports:reset": "npm run ports:kill && sleep 2 && echo 'Ports reset complete'",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:8091": "VITE_TEST_PORT=8091 vitest --ui --port 8091",
    "test:production": "RUN_PRODUCTION_TESTS=1 vitest run src/test/production --testTimeout=120000 --hookTimeout=30000",
    "markdown:fix": "node fix-markdown.cjs",
    "markdown:fix-all": "node fix-markdown.cjs --all",
    "markdown:check": "node fix-markdown.cjs --all --dry-run",
    "markdown:clean": "node fix-markdown.cjs --clean",
    "markdown:help": "node fix-markdown.cjs --help",
    "dossier": "bash scripts/build-valuation-dossier.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.56.2",
    "@types/node-fetch": "^2.6.12",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "1.0.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "embla-carousel-react": "^8.3.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "input-otp": "^1.2.4",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "node-fetch": "^2.7.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-resizable-panels": "^2.1.3",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.13.0",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "lovable-tagger": "^1.1.7",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.59.4",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
